{
  "name": "chatgpt-pro-research",
  "version": "0.3.6",
  "description": "DSH 插件：优先 Pro、兼容可用网页模型的可恢复多轮调研，按判据裁决，保留原答复并交付本地报告。Resumable ChatGPT web research with Pro preference, criterion-based judging and local reports.",
  "private": false,
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "resources",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "chatgpt",
    "research",
    "browser-automation",
    "cordis"
  ],
  "author": "Octo-o-o-o",
  "license": "MIT",
  "homepage": "https://github.com/Octo-o-o-o/chatgpt-pro-research#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Octo-o-o-o/chatgpt-pro-research.git"
  },
  "bugs": {
    "url": "https://github.com/Octo-o-o-o/chatgpt-pro-research/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dependencies": {
    "playwright-core": "^1.64.1"
  }
}
